{
  "_metadata": {
    "description": "Halo 2 Xbox memory addresses, struct layouts, and constants",
    "game_version": "Halo 2 Xbox v1.0/v1.5 retail",
    "xbe_module": "halo2ship.exe",
    "xbe_base": "0x000118E0",
    "xbe_size": "0x005ADBC0",
    "last_verified": "2026-02"
  },

  "post_game": {
    "_doc": "Post-game carnage report addresses (XBDM-accessible, working)",
    "pgcr_display": {
      "header": "0x56B900",
      "header_size": "0x90",
      "gametype_offset": "0x84",
      "gametype_addr": "0x56B984",
      "player_base": "0x56B990",
      "player_stride": "0x114",
      "team_base": "0x56CAD0",
      "team_stride": "0x84"
    },
    "pcr_fallback": {
      "_doc": "PCR stats - EMPTY on docker-bridged-xemu, fallback only",
      "player_base": "0x55CAF0",
      "player_stride": "0x114",
      "team_base": "0x55DC30",
      "team_stride": "0x84"
    },
    "breakpoint": {
      "pgcr_clear": "0x23975C",
      "_doc": "Code address: PGCR clear function, fires at game end"
    },
    "gametype_addresses": {
      "xbox7887": {
        "address": "0x50224C",
        "_doc": "Reads as zero on docker-bridged-xemu. Do not use."
      },
      "pgcr_header": {
        "address": "0x56B984",
        "_doc": "Stale on docker-bridged-xemu, always reads 5. Do not rely on."
      }
    },
    "misc": {
      "str_kills": "0x4603B8",
      "str_deaths": "0x4603A8",
      "profile_data": "0x53D000"
    }
  },

  "discovered": {
    "_doc": "Empirically discovered Xbox addresses (verified Feb–Mar 2026)",
    "gametype_confirmed": "0x52ED24",
    "_gametype_confirmed_doc": "int32 gametype enum. Verified for ALL 7 gametypes via 7-way cross-reference. Primary gametype source. Timing-sensitive: read while PGCR is populated.",
    "pgcr_display_base": "0x56B900",
    "variant_info": {
      "_doc": "XBE-relative offsets for variant name + map name. Read via _read_via_data_section_offset() which translates .data section VA to physical, then adds linear offset. Stable across xemu sessions.",
      "xbe_offset": "0x35AD0EC",
      "xbe_offset_doc": "Offset from XBE base to variant_info struct. Source: halo-scraper OffVariantInfo.",
      "struct_size": "0x230",
      "variant_name_offset": "0x00",
      "variant_name_size": "0x20",
      "variant_name_doc": "UTF-16LE[16] (32 bytes) at +0x00. Game variant display name.",
      "gametype_byte_offset": "0x40",
      "gametype_byte_doc": "Single byte at variant_name + 0x40. Gametype enum (1=CTF, 2=Slayer, etc.).",
      "map_content_path_offset": "-0xA4",
      "map_content_path_size": "0xA4",
      "map_content_path_doc": "ASCII null-terminated, 0xA4 bytes before variant_name. Xbox content path format: 't:\\$C\\<title_id>\\<map_name>'.",
      "scenario_path_offset": "0x130",
      "scenario_path_size": "0x100",
      "scenario_path_doc": "ASCII null-terminated scenario/content path found in some runtime layouts.",
      "_legacy_physical_variant_name": "0x036295F4",
      "_legacy_physical_map_content_path": "0x03629550",
      "_legacy_note": "Physical addresses from a single session (2026-03-28). Shift between xemu restarts — do not use directly."
    },
    "live_map_metadata": {
      "_doc": "Physical RAM metadata block observed in controlled xemu snapshots. Use only as a sanity-checked fallback because it may vary by runtime.",
      "display_name_physical": "0x01917000",
      "description_physical": "0x01917008",
      "display_name_size": "0x40",
      "description_size": "0xC0"
    },
    "active_variant_name_physical": {
      "_doc": "UTF-16LE active variant-name copies found by SBORG A1/A2 RAM-dump comparison on Sayian. These survived lobby and PGCR and were verified by direct QMP _read_physical().",
      "verified_on": "2026-06-08",
      "size": "0x20",
      "candidates": [
        "0x035E2490",
        "0x03629D3C",
        "0x0366B1EC",
        "0x036D3384"
      ],
      "_excluded": {
        "0x037398F4": "Marker appeared in dumps but was not stable under later direct QMP read."
      }
    }
  },

  "sizing": {
    "max_players": 16,
    "max_teams": 8
  },

  "structs": {
    "pcr_stat_player": {
      "size": "0x114",
      "fields": {
        "player_name":     { "offset": "0x00", "type": "utf16le[16]", "size": 32 },
        "display_name":    { "offset": "0x20", "type": "utf16le[16]", "size": 32 },
        "score_string":    { "offset": "0x40", "type": "utf16le[16]", "size": 32 },
        "kills":           { "offset": "0x60", "type": "int32" },
        "deaths":          { "offset": "0x64", "type": "int32" },
        "assists":         { "offset": "0x68", "type": "int32" },
        "suicides":        { "offset": "0x6C", "type": "int32" },
        "place":           { "offset": "0x70", "type": "int16" },
        "team":            { "offset": "0x72", "type": "int16" },
        "observer":        { "offset": "0x74", "type": "bool" },
        "rank":            { "offset": "0x78", "type": "int16" },
        "rank_verified":   { "offset": "0x7A", "type": "int16" },
        "medals_earned":   { "offset": "0x7C", "type": "int32" },
        "medals_by_type":  { "offset": "0x80", "type": "int32", "_doc": "24-bit bitmask" },
        "total_shots":     { "offset": "0x84", "type": "int32" },
        "shots_hit":       { "offset": "0x88", "type": "int32" },
        "headshots":       { "offset": "0x8C", "type": "int32" },
        "killed_array":    { "offset": "0x90", "type": "int32[16]", "size": 64 },
        "place_string":    { "offset": "0xE0", "type": "utf16le[16]", "size": 32 },
        "gametype_value0": { "offset": "0x10C", "type": "int32" },
        "gametype_value1": { "offset": "0x110", "type": "int32" }
      }
    },
    "team_stats": {
      "size": "0x84",
      "fields": {
        "name":         { "offset": "0x00", "type": "utf16le[32]", "size": 64 },
        "score_string": { "offset": "0x40", "type": "utf16le", "size": 32 },
        "place":        { "offset": "0x60", "type": "int16" },
        "team_id":      { "offset": "0x62", "type": "int16" },
        "place_string": { "offset": "0x64", "type": "utf16le", "size": 32 }
      }
    }
  },

